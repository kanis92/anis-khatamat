rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email == 'jaouadk@gmail.com';
    }

    function userEmail() {
      return request.auth.token.get('email', null);
    }

    function userUid() {
      return request.auth.uid;
    }

    function canonicalId() {
      return userEmail() != null ? userEmail() : userUid();
    }

    function parentData(khatmaId) {
      return get(/databases/$(database)/documents/khatmat/$(khatmaId)).data;
    }

    function isCreatorOf(data) {
      return userEmail() != null && data.createdBy == userEmail();
    }

    // Tous les identifiants prouvés du MÊME appelant : son email vérifié et son
    // uid Firebase. Aucun n'est falsifiable, ils viennent du token.
    // Nécessaire car un compte email peut figurer dans participantIds sous son
    // uid (session invitée antérieure, puis connexion) : c'est déjà le modèle
    // appliqué côté client par userBelongsToKhatma. Sans cet alignement, la
    // requête participantIds/authUid de getMyKhatmat retourne un document que
    // les rules refusent, et Firestore rejette la requête entière.
    function selfIds() {
      return userEmail() != null ? [userEmail(), userUid()] : [userUid()];
    }

    function isGuestOf(data) {
      return data.get('guestParticipants', {}).keys().hasAny(selfIds());
    }

    function isEmailMemberOf(data) {
      return userEmail() != null && data.get('members', []).hasAny([userEmail()]);
    }

    function isMemberOf(data) {
      return isEmailMemberOf(data)
        || isGuestOf(data)
        || data.get('participantIds', []).hasAny(selfIds());
    }

    function canReadKhatmaData(data) {
      return isAdmin()
        || isCreatorOf(data)
        || isMemberOf(data)
        || data.get('isPublic', false) == true;
    }

    // Réservé aux sous-collections, où khatmaId est lié par le chemin.
    // Sur /khatmat lui-même, utiliser canReadKhatmaData(resource.data) :
    // lors d'un `list` le wildcard khatmaId est nul et get() lèverait
    // « Null value error », ce qui refusait TOUTE requête sur la collection.
    function canReadKhatma(khatmaId) {
      return canReadKhatmaData(parentData(khatmaId));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'senderEmail', 'createdAt'])
        && data.text is string && data.text.size() <= 5000;
    }

    function isValidKhatmaCreate(data) {
      return data.keys().hasAll(['title', 'createdBy', 'createdAt', 'isGroup'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.createdBy is string && data.createdAt is string && data.isGroup is bool
        && (
          !data.keys().hasAny(['participantIds'])
          || (data.participantIds.size() >= 1
              && data.participantIds.hasAny([data.createdBy]))
        )
        && (
          data.get('reservationMode', false) != true
          || data.get('reservationSchemaVersion', 1) < 2
          || (data.keys().hasAny(['hizbDefinitionId'])
              && data.hizbDefinitionId == 'quran_foundation_hafs_v1')
        );
    }

    function onlyFieldsChanged(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function emailJoinAddsSelf() {
      return userEmail() != null
        && request.resource.data.get('members', []).hasAll(resource.data.get('members', []))
        && request.resource.data.get('members', []).hasAny([userEmail()])
        && request.resource.data.get('members', []).size()
            <= resource.data.get('members', []).size() + 1;
    }

    function guestJoinAddsSelf() {
      let gpDiff = request.resource.data.get('guestParticipants', {})
          .diff(resource.data.get('guestParticipants', {}));
      let anonJoin = request.resource.data.get('guestParticipants', {}).keys().hasAny([userUid()])
        && gpDiff.addedKeys().hasOnly([userUid()])
        && gpDiff.removedKeys().size() == 0 && gpDiff.changedKeys().size() == 0;
      let emailJoin = userEmail() != null
        && request.resource.data.get('guestParticipants', {}).keys().hasAny([userEmail()])
        && gpDiff.addedKeys().hasOnly([userEmail()])
        && gpDiff.removedKeys().size() == 0 && gpDiff.changedKeys().size() == 0;
      return anonJoin || emailJoin;
    }

    function participantIdJoinAddsSelf() {
      let oldIds = resource.data.get('participantIds', []);
      let newIds = request.resource.data.get('participantIds', []);
      return newIds.hasAll(oldIds)
        && newIds.hasAny([canonicalId()])
        && newIds.size() <= oldIds.size() + 1;
    }

    // Chaque branche d'update commence par restreindre les clés modifiées.
    // C'est à la fois le garde-fou de sécurité (aucun champ structurel ne peut
    // bouger : createdBy, title, isPublic… ne figurent jamais dans la liste
    // autorisée) et la condition pour rester sous le budget de 1000
    // expressions du moteur de rules, que l'ancienne version dépassait.
    function joinUpdateValid() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return (diff.hasOnly(['members']) && emailJoinAddsSelf())
        || (diff.hasOnly(['guestParticipants']) && guestJoinAddsSelf())
        || (diff.hasOnly(['members', 'participantIds'])
            && emailJoinAddsSelf() && participantIdJoinAddsSelf())
        || (diff.hasOnly(['guestParticipants', 'participantIds'])
            && guestJoinAddsSelf() && participantIdJoinAddsSelf())
        || (diff.hasOnly(['members', 'guestParticipants', 'participantIds'])
            && emailJoinAddsSelf() && guestJoinAddsSelf() && participantIdJoinAddsSelf());
    }

    function schemaVersionUpgradeValid() {
      return onlyFieldsChanged(['reservationSchemaVersion', 'completedHizbCount'])
        && resource.data.get('reservationSchemaVersion', 1) < 2
        && request.resource.data.reservationSchemaVersion == 2
        && isMemberOf(resource.data);
    }

    function parentCounterUpdateValid() {
      let oldCount = resource.data.get('completedHizbCount', 0);
      let newCount = request.resource.data.get('completedHizbCount', 0);
      let reaching60 = oldCount == 59 && newCount == 60;
      let hadCompletedAt = resource.data.get('completedAt', null) != null;
      let fieldsOk = reaching60
        ? onlyFieldsChanged(['completedHizbCount', 'completedAt'])
        : onlyFieldsChanged(['completedHizbCount']);
      return fieldsOk
        && newCount == oldCount + 1
        && (!reaching60 || !hadCompletedAt)
        && resource.data.get('reservationSchemaVersion', 1) >= 2
        && isMemberOf(resource.data);
    }

    // ─── Hizb reservation doc helpers ───────────────────────────────────

    function hizbDataValid(d, hizbNumber) {
      return d.keys().hasAll(['hizbNumber', 'status'])
        && d.hizbNumber is int
        && d.hizbNumber == int(hizbNumber)
        && d.hizbNumber >= 1 && d.hizbNumber <= 60
        && d.status is string
        && d.status in ['available', 'softLocked', 'reserved', 'inProgress', 'completed', 'expired'];
    }

    function hasCanonicalSnapshot(d) {
      return d.keys().hasAll([
          'hizbNumber', 'status', 'hizbDefinitionId',
          'startVerseKey', 'endVerseKey', 'startPageHafs', 'endPageHafs'])
        && d.hizbDefinitionId is string
        && d.hizbDefinitionId == 'quran_foundation_hafs_v1'
        && d.startVerseKey is string
        && d.endVerseKey is string
        && d.startPageHafs is int
        && d.endPageHafs is int;
    }

    function snapshotImmutable(old, d) {
      return !old.keys().hasAny(['hizbDefinitionId'])
        || (d.hizbNumber == old.hizbNumber
            && d.get('hizbDefinitionId', '') == old.get('hizbDefinitionId', '')
            && d.get('startVerseKey', '') == old.get('startVerseKey', '')
            && d.get('endVerseKey', '') == old.get('endVerseKey', '')
            && d.get('startPageHafs', -1) == old.get('startPageHafs', -1)
            && d.get('endPageHafs', -1) == old.get('endPageHafs', -1));
    }

    function releasePreservesSnapshot(old, d) {
      return d.status == 'available' && snapshotImmutable(old, d);
    }

    function reservedByCaller(d) {
      return d.get('reservedBy', '') == canonicalId();
    }

    function ownsExistingReservation(old) {
      return old.get('reservedBy', '') == canonicalId()
        || old.get('softLockedBy', '') == canonicalId();
    }

    function reservedByImmutable(old, d) {
      return d.get('reservedBy', '') == old.get('reservedBy', '');
    }

    function adminOrCreatorOf(khatmaId) {
      let p = parentData(khatmaId);
      return isAdmin() || isCreatorOf(p);
    }

    function hizbWriteAllowed(khatmaId, hizbNumber) {
      let p = parentData(khatmaId);
      let d = request.resource.data;
      let docPath = /databases/$(database)/documents/khatmat/$(khatmaId)/hizb_reservations/$(hizbNumber);
      let existsDoc = exists(docPath);
      let old = existsDoc ? resource.data : {};
      let schemaV2 = p.get('reservationSchemaVersion', 1) >= 2;

      return hizbDataValid(d, hizbNumber) && (
        (adminOrCreatorOf(khatmaId)
          && releasePreservesSnapshot(old, d)
          && (d.keys().hasOnly(['hizbNumber', 'status'])
              || hasCanonicalSnapshot(d)))
        || (!existsDoc && (
          (adminOrCreatorOf(khatmaId)
            && d.status == 'available'
            && (d.keys().hasOnly(['hizbNumber', 'status'])
                || hasCanonicalSnapshot(d)))
          || (!schemaV2 && isMemberOf(p))
          || (schemaV2 && isMemberOf(p) && d.status == 'reserved' && reservedByCaller(d)
              && (!p.keys().hasAny(['hizbDefinitionId']) || hasCanonicalSnapshot(d)))
        ))
        || (existsDoc && isMemberOf(p) && snapshotImmutable(old, d) && (
          (d.status == 'reserved' && reservedByCaller(d) && (
            old.status == 'available' || old.status == 'expired'
            || (old.status == 'softLocked' && old.get('softLockedBy', '') == canonicalId())
            || (old.status == 'reserved' && old.get('reservedBy', '') == canonicalId())
          ))
          || (ownsExistingReservation(old)
            && releasePreservesSnapshot(old, d)
            && (old.status == 'reserved' || old.status == 'inProgress' || old.status == 'softLocked'))
          || (ownsExistingReservation(old)
            && (old.get('reservedBy', '') == '' || reservedByImmutable(old, d))
            && (
              (old.status == 'reserved' && d.status == 'inProgress' && reservedByCaller(d))
              || ((old.status == 'reserved' || old.status == 'inProgress')
                && d.status == 'completed' && reservedByCaller(d))
              || (d.status == 'softLocked' && d.get('softLockedBy', '') == canonicalId()
                && (old.status == 'available' || old.status == 'expired'
                  || (old.status == 'softLocked' && old.get('softLockedBy', '') == canonicalId())))
              || (old.status == 'reserved' && d.status == 'reserved' && reservedByCaller(d)
                && d.extendedCount == 1 && old.get('extendedCount', 0) == 0)
            ))
        ))
      );
    }

    // ─── Khatmat ─────────────────────────────────────────────────────────
    match /khatmat/{khatmaId} {
      allow read: if request.auth != null && canReadKhatmaData(resource.data);

      allow create: if request.auth != null
        && userEmail() != null
        && isValidKhatmaCreate(request.resource.data)
        && request.resource.data.createdBy == userEmail();

      allow update: if request.auth != null
        && (isAdmin() || isCreatorOf(resource.data) || joinUpdateValid()
            || schemaVersionUpgradeValid() || parentCounterUpdateValid());

      allow delete: if request.auth != null && (isAdmin() || isCreatorOf(resource.data));

      match /hizb_reservations/{hizbNumber} {
        allow read: if request.auth != null && canReadKhatma(khatmaId);
        allow create, update: if request.auth != null
          && canReadKhatma(khatmaId)
          && hizbWriteAllowed(khatmaId, hizbNumber);
        allow delete: if false;
      }
    }

    // Requête collectionGroup de fetchUserActiveReservationsFromSubcollection.
    // Un `match` imbriqué ne couvre PAS les collection group queries : sans ce
    // chemin dédié, la requête tombait sur le deny-all final.
    // Portée volontairement plus étroite que la règle imbriquée : on ne peut
    // lister que SES propres réservations, jamais celles d'un autre lecteur.
    match /{path=**}/hizb_reservations/{hizbNumber} {
      allow read: if request.auth != null
        && resource.data.get('reservedBy', '') == canonicalId();
    }

    match /reading_progress/{docId} {
      allow read, write: if request.auth != null
        && (resource.data.userId == userEmail()
            || resource.data.userId == userUid()
            || resource.data.get('authUid', '') == userUid());
      allow create: if request.auth != null
        && (request.resource.data.userId == userEmail()
            || request.resource.data.userId == userUid()
            || request.resource.data.get('authUid', '') == userUid());
    }

    match /workshops/{workshopId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.createdBy == userEmail();
      allow update, delete: if request.auth != null
        && (isAdmin() || resource.data.createdBy == userEmail());
    }

    match /certified_chat_messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /khatmat/{khatmaId}/chat_messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
