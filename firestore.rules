rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }

    function userEmail() {
      return request.auth.token.get('email', null);
    }

    function userUid() {
      return request.auth.uid;
    }

    function canonicalId() {
      return request.auth.token.get('email', request.auth.uid);
    }

    function parentData(khatmaId) {
      return get(/databases/$(database)/documents/khatmat/$(khatmaId)).data;
    }

    function isCreatorOf(data) {
      return userEmail() != null && data.createdBy == userEmail();
    }

    // Combined self identifiers (email + UID) for membership checks
    function selfIds() {
      return [request.auth.token.get('email', request.auth.uid), request.auth.uid];
    }

    function isMemberOf(data) {
      let ids = selfIds();
      return data.get('members', []).hasAny([request.auth.token.get('email', '')])
        || data.get('guestParticipants', {}).keys().hasAny(ids)
        || data.get('participantIds', []).hasAny(ids);
    }

    function canReadKhatmaData(data) {
      return isAdmin()
        || isCreatorOf(data)
        || isMemberOf(data)
        || data.get('isPublic', false) == true;
    }

    function isInitializing(data) {
      return data.get('creationState', 'ready') == 'initializing';
    }

    function canReadKhatma(khatmaId) {
      let p = parentData(khatmaId);
      return canReadKhatmaData(p)
        && (!isInitializing(p) || isCreatorOf(p) || isAdmin());
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'senderEmail', 'createdAt'])
        && data.text is string && data.text.size() <= 5000;
    }

    // ─── Khatmat (Server-Authoritative Writes) ───────────────────────────
    // All Khatma creation and Hizb mutations are now handled by Firebase
    // callable Functions. Clients can only READ.
    match /khatmat/{khatmaId} {
      // Read: authorized participants, creator, admin, or public
      allow read: if isSignedIn()
        && canReadKhatmaData(resource.data)
        && (!isInitializing(resource.data) || isCreatorOf(resource.data) || isAdmin());

      // Write: DENIED for clients (server-authoritative via Functions)
      allow create, update, delete: if false;

      match /hizb_reservations/{hizbNumber} {
        // Read: same access as parent Khatma
        allow read: if isSignedIn() && canReadKhatma(khatmaId);

        // Write: DENIED for clients (server-authoritative via Functions)
        allow create, update, delete: if false;
      }
    }

    // Collection group query for user's active reservations
    match /{path=**}/hizb_reservations/{hizbNumber} {
      allow read: if isSignedIn()
        && resource.data.get('reservedBy', '') == canonicalId();
    }

    // ─── Reading Progress ─────────────────────────────────────────────────
    match /reading_progress/{docId} {
      allow read, write: if isSignedIn()
        && (resource.data.userId == userEmail()
            || resource.data.userId == userUid()
            || resource.data.get('authUid', '') == userUid());
      allow create: if isSignedIn()
        && (request.resource.data.userId == userEmail()
            || request.resource.data.userId == userUid()
            || request.resource.data.get('authUid', '') == userUid());
    }

    // ─── Workshops ────────────────────────────────────────────────────────
    match /workshops/{workshopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == userEmail();
      allow update, delete: if isSignedIn()
        && (isAdmin() || resource.data.createdBy == userEmail());
    }

    // ─── Chat Messages ────────────────────────────────────────────────────
    match /certified_chat_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /khatmat/{khatmaId}/chat_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    // ─── Formations ───────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();

      match /modules/{moduleId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isAdmin();
      }

      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isAdmin();
      }
    }

    match /users/{userId}/formationProgress/{progressId} {
      // Personal Formation progress is server-authoritative via REST API only
      // Client reads and writes both go through authenticated API endpoints
      allow read, write: if false;
    }

    match /users/{userId}/savedFormations/{savedItemId} {
      // Saved Formation items are server-authoritative via REST API only
      // Client reads and writes both go through authenticated API endpoints
      allow read, write: if false;
    }

    // ─── Lives ────────────────────────────────────────────────────────────
    match /lives/{liveId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();

      match /registrations/{regId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && (isAdmin() || resource.data.userId == request.auth.uid);
      }

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && (isAdmin() || resource.data.userId == request.auth.uid);
      }
    }

    // ─── Weekly Q&A ───────────────────────────────────────────────────────
    match /weekly_qa/{qaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // ─── Questions ────────────────────────────────────────────────────────
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isAdmin();
    }

    // ─── Default Deny ─────────────────────────────────────────────────────
    // All unmatched paths are denied by default (Firestore behavior)
  }
}
