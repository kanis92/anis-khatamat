# Copier vers api/.deploy.env (non commité)
#
# DEPLOY_SSH = alias SSH (~/.ssh/config) ou user@hostname Infomaniak
# DEPLOY_PATH = dossier de l’API sur le serveur (contient package.json)
#
# Exemple :
# DEPLOY_SSH=anis-api-prod
# DEPLOY_PATH=/srv/customer/sites/api.anis-khatamat.com
# PM2_NAME=anis-api

DEPLOY_SSH=
DEPLOY_PATH=
