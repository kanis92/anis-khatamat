# ANIS API Environment Configuration Example
# Copy to .env for local development (NEVER commit .env)

# Environment (development, test, production)
NODE_ENV=development

# Server port
PORT=8080

# Firebase Project ID
FIREBASE_PROJECT_ID=anis-437c3

# Allowed CORS origins (comma-separated)
# Production example: https://anis-khatamat.com,https://www.anis-khatamat.com,https://admin.anis-khatamat.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Body size limit in bytes (default 1MB)
BODY_LIMIT_BYTES=1048576

# Firebase Admin Credentials (production only)
# Use one of:
# 1. GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 2. Application Default Credentials (ADC) on Cloud Run/GCE
# NEVER commit service-account JSON files

# Firebase Emulator (development/test)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
